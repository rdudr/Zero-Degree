# Neon / Supabase / local Postgres — optional. Without it the app still works
# fully offline; only "Pull team data" from the cloud is unavailable.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zero_degree?schema=public"

# Email for Submit / Email Report (SMTP is used when set, otherwise Resend)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Zero Degree <noreply@resend.dev>"

# Extra PostMan deployments allowed to open this app (comma separated)
NEXT_PUBLIC_POSTMAN_ORIGINS=""
